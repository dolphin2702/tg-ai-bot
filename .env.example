# ============================================================
# Telegram
# ============================================================
TELEGRAM_TOKEN=

# Telegram user IDs allowed to use the bot in private chats.
# Comma-separated. Leave empty to allow everyone (dev mode).
# Find your ID: send /id to the bot, or use @userinfobot.
ALLOWED_USERS=

# Telegram chat IDs of allowed groups. Comma-separated.
# Negative numbers, usually start with -100.
# Find it: add the bot to the group, send /id, copy chat_id.
ALLOWED_CHATS=

# ============================================================
# State storage
# ============================================================
# Redis URL. Leave empty for in-memory state (dev only —
# history resets on every restart).
# REDIS_URL=redis://redis:6379/0

# ============================================================
# Behaviour
# ============================================================
# Default system prompt (applies to stateless engines).
SYSTEM_PROMPT=Ты — полезный ассистент. Отвечай чётко, по делу, на языке пользователя.

# Max messages kept per user per engine (system prompt not counted).
# Older messages are trimmed when a new one arrives.
HISTORY_LIMIT=50

# ============================================================
# Engines
# ============================================================
# Which engine is used if the user hasn't picked one.
DEFAULT_ENGINE=lmstudio

# Comma-separated list of OpenAI-compatible engine names.
# For each NAME listed here, the bot reads:
#   <NAME>_BASE_URL, <NAME>_API_KEY, <NAME>_MODEL
OPENAI_ENGINES=lmstudio,openrouter,ollama

# --- LM Studio (usually running on your Mac) ---
# From the same machine: http://localhost:1234/v1
# From another host over WireGuard: http://10.8.0.2:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen2.5-7b-instruct

# --- OpenRouter ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.1

# --- Mistral (uncomment to enable; add "mistral" to OPENAI_ENGINES) ---
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# --- OpenAI (uncomment to enable) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ============================================================
# AnythingLLM (optional, stateful)
# ============================================================
# Uncomment to enable. System prompt is managed inside AnythingLLM.
# ANYTHINGLLM_URL=http://anythingllm:3001
# ANYTHINGLLM_API_KEY=
# ANYTHINGLLM_WORKSPACE=default

# Words that trigger the bot in groups (case-insensitive).
# Example: "ИИ, какая погода в Самаре" — bot sees "ИИ," and responds.
GROUP_TRIGGERS=ии,ai,бот,bot